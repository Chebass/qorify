# Copia a .env.local y completa con los valores de tu proyecto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Clave AES-GCM de 32 bytes en base64 para cifrar notas (openssl rand -base64 32)
NOTES_ENCRYPTION_KEY=

# WebAuthn (biometría). Para desarrollo: localhost; en producción tu dominio *.vercel.app
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
